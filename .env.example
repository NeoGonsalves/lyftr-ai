# Two or more comma-separated keys. Never commit real values.
LLM_API_KEYS=key-one,key-two
# Use a LiteLLM provider/model identifier compatible with the selected keys.
LLM_MODEL=groq/openai/gpt-oss-120b
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are LYFTR AI, a crisp, concise, and structured assistant.
LITELLM_CACHE_DIR=/data/litellm-cache
